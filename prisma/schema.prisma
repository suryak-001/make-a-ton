// SHARED FILE — ping your teammate before changing it. One migration per PR.
// Ownership: Identity/Catalog/Subscriptions = Person A, Tax/Discount/Invoice/Payment = Person B.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Identity (A) ───────────────────────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())

  customer             Customer?
  resetTokens          PasswordResetToken[]
  createdSubscriptions Subscription[]       @relation("SubscriptionCreatedBy")
  recordedPayments     Payment[]            @relation("PaymentRecordedBy")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  address   String?
  userId    String?  @unique // set when the customer has a portal login
  createdAt DateTime @default(now())

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([email])
  @@index([name])
}

// ─────────────────────────────── Catalog (A) ────────────────────────────────

enum ProductType {
  SERVICE
  GOODS
}

model Product {
  id         String      @id @default(cuid())
  name       String
  type       ProductType @default(SERVICE)
  salesPrice Decimal     @db.Decimal(12, 2)
  costPrice  Decimal     @default(0) @db.Decimal(12, 2)
  notes      String?
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())

  variants          ProductVariant[]
  defaultTaxes      Tax[]                   @relation("ProductDefaultTaxes")
  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
  discounts         Discount[]              @relation("DiscountProducts")
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  attribute  String // e.g. "Brand"
  value      String // e.g. "Odoo"
  extraPrice Decimal @default(0) @db.Decimal(12, 2) // e.g. 560

  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]

  @@unique([productId, attribute, value])
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Plan {
  id            String        @id @default(cuid())
  name          String
  price         Decimal       @db.Decimal(12, 2)
  billingPeriod BillingPeriod
  minQuantity   Int           @default(1)
  availableFrom DateTime?
  availableTo   DateTime?
  autoClose     Boolean       @default(false) // close automatically at expiry
  closable      Boolean       @default(true) // can be closed early
  pausable      Boolean       @default(false)
  renewable     Boolean       @default(true)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())

  templates     QuotationTemplate[]
  subscriptions Subscription[]
}

model QuotationTemplate {
  id           String   @id @default(cuid())
  name         String
  planId       String
  validityDays Int      @default(30)
  notes        String?
  createdAt    DateTime @default(now())

  plan  Plan                    @relation(fields: [planId], references: [id])
  lines QuotationTemplateLine[]
}

model QuotationTemplateLine {
  id         String @id @default(cuid())
  templateId String
  productId  String
  variantId  String?
  quantity   Int    @default(1)

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])
  variant  ProductVariant?   @relation(fields: [variantId], references: [id])
}

// ───────────────────────────── Subscriptions (A) ────────────────────────────

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

model Subscription {
  id                  String             @id @default(cuid())
  number              String             @unique // SUB-00001
  customerId          String
  planId              String
  status              SubscriptionStatus @default(DRAFT)
  startDate           DateTime
  expiryDate          DateTime?
  paymentTermDays     Int                @default(15)
  quotationValidUntil DateTime?
  nextInvoiceDate     DateTime? // set on activation; advanced by the billing run (B)
  notes               String?
  createdById         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  customer  Customer           @relation(fields: [customerId], references: [id])
  plan      Plan               @relation(fields: [planId], references: [id])
  createdBy User?              @relation("SubscriptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines     SubscriptionLine[]
  invoices  Invoice[]
  discounts Discount[]         @relation("DiscountSubscriptions")

  @@index([status])
  @@index([customerId])
  @@index([status, nextInvoiceDate])
}

model SubscriptionLine {
  id             String  @id @default(cuid())
  subscriptionId String
  productId      String
  variantId      String?
  quantity       Int     @default(1)
  unitPrice      Decimal @db.Decimal(12, 2) // product price + variant extra at time of quoting
  amount         Decimal @db.Decimal(12, 2) // computed via lib/pricing

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  taxes        Tax[]           @relation("SubscriptionLineTaxes")

  @@index([subscriptionId])
}

// ───────────────────────────── Taxes & discounts (B) ────────────────────────

enum AmountKind {
  PERCENT
  FIXED
}

model Tax {
  id        String     @id @default(cuid())
  name      String
  kind      AmountKind @default(PERCENT)
  rate      Decimal    @db.Decimal(12, 2) // 18 = 18% when PERCENT, 18.00 per unit when FIXED
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  products          Product[]          @relation("ProductDefaultTaxes")
  subscriptionLines SubscriptionLine[] @relation("SubscriptionLineTaxes")
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

model Discount {
  id          String        @id @default(cuid())
  name        String
  kind        AmountKind
  value       Decimal       @db.Decimal(12, 2)
  minPurchase Decimal?      @db.Decimal(12, 2)
  minQuantity Int?
  startDate   DateTime
  endDate     DateTime?
  usageLimit  Int?
  usedCount   Int           @default(0)
  scope       DiscountScope
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())

  products      Product[]       @relation("DiscountProducts")
  subscriptions Subscription[]  @relation("DiscountSubscriptions")
  usages        DiscountUsage[]

  @@index([active, startDate, endDate])
}

// ───────────────────────────── Invoices & payments (B) ──────────────────────

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique // INV-2026-00001
  subscriptionId String
  customerId     String
  status         InvoiceStatus @default(DRAFT)
  periodStart    DateTime
  periodEnd      DateTime
  invoiceDate    DateTime
  dueDate        DateTime
  subtotal       Decimal       @db.Decimal(12, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  sentAt         DateTime?
  createdAt      DateTime      @default(now())

  subscription   Subscription    @relation(fields: [subscriptionId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  lines          InvoiceLine[]
  payments       Payment[]
  discountUsages DiscountUsage[]

  @@unique([subscriptionId, periodStart]) // the "never bill twice" guarantee
  @@index([status, dueDate])
  @@index([customerId])
  @@index([invoiceDate])
}

// Snapshot of the subscription line at billing time; later catalog edits don't change old invoices.
model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  productId      String?
  description    String
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model DiscountUsage {
  id         String   @id @default(cuid())
  discountId String
  invoiceId  String
  createdAt  DateTime @default(now())

  discount Discount @relation(fields: [discountId], references: [id])
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([discountId, invoiceId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  CHEQUE
  OTHER
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  paymentDate  DateTime
  note         String?
  recordedById String?
  createdAt    DateTime      @default(now())

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([paymentDate])
}

// ───────────────────────────── Shared ───────────────────────────────────────

// Atomic document numbering (SUB, INV-2026, ...). Use lib/sequence.ts, never count rows.
model Sequence {
  name String @id
  next Int    @default(1)
}
